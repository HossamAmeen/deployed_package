staging:
  ip: 35.226.179.10
  username: hossam
  ssh_file: ~/.ssh/google_compute_engine
  docker: false                      # false: systemd + venv (no docker)
  ssl: false                         # true: install Let's Encrypt certificates (domains must point to this server)
  ssl_email: hosamameen948@gmail.com # required when ssl: true

  # One repo for both projects: same git_url + remote_path, different subdir.
  frontend:
    domain: abosamra.hossam-ameen.online
    git_url: https://github.com/HossamAmeen/abosamra.git
    branch: main
    remote_path: /var/www/abosamra/staging   # checkout on the server
    subdir: frontend                         # folder of the Vue project inside the repo
    web_root: /var/www/html/abosamra/staging # nginx serves this folder, it holds only the built dist
    api_url: http://api.abosamra.hossam-ameen.online

  backend:
    domain: api.abosamra.hossam-ameen.online
    git_url: https://github.com/HossamAmeen/abosamra.git
    branch: main
    remote_path: /var/www/abosamra/staging   # same checkout as the frontend
    subdir: backend                          # folder of the Django project inside the repo
    service_name: abosamra-backend           # systemd service name
    port: 8001                               # local port the backend listens on
    workers: 2                               # gunicorn worker processes
    static_url: /static/
    media_url: /media/
    static_root: /var/www/abosamra/static
    media_root: /var/www/abosamra/media
    requirements_path: requirements/production.txt      # relative to the backend folder
    wsgi_module: config.wsgi:application
